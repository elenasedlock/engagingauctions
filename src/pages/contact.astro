---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Field from '../components/Field.astro';
import Btn from '../components/Btn.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Each detail sits in its own pink panel with a maroon icon tile.
const details = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'envelope' as const },
  { label: 'Call Now', value: site.phone, href: site.phoneHref, icon: 'phone' as const },
  { label: 'Office Location', value: site.locationContact, href: null, icon: 'location' as const },
];
---

<Base
  title="Contact"
  description="Get in touch with Engaging Auctions about your upcoming fundraising event, gala, or school auction."
>
  <PageBanner title="Contact" />

  <section class="wrap">
    <div class="flex flex-col py-[70px] md:py-[60px] lg:py-[70px]">
      <!-- Intro: Cormorant, capitalized, centred, max 980px -->
      <p class="mx-auto max-w-[980px] text-center font-display text-[25px] font-medium capitalize leading-[30px] text-ink">
        Looking forward to speaking with you more about your upcoming event.
        Fill out the form or Schedule a time directly with Elena below
      </p>

      <div class="mt-[30px] flex flex-col lg:flex-row lg:gap-0">
        <!-- Left: heading, CTA, contact panels -->
        <div class="flex flex-col gap-5 p-2.5 lg:w-[32%] lg:shrink-0">
          <div class="border-l-[5px] border-maroon pl-[15px]">
            <h2>Let's Talk About Your Event</h2>
          </div>

          <Btn href="/consultation/" class="block w-full">Schedule A Call With Elena</Btn>

          <ul class="flex flex-col gap-5">
            {details.map((d) => (
              <li class="flex items-center gap-4 bg-tint4 p-[25px]">
                <Icon name={d.icon} size={25} view="stacked" box={50} />
                <div class="min-w-0">
                  <p class="font-display text-[30px] font-medium capitalize leading-[36px] text-ink">{d.label}</p>
                  {d.href
                    ? <a href={d.href} class="block break-words font-sans text-[17px] font-light leading-[25.5px] text-[#2E2E2E] hover:text-maroon">{d.value}</a>
                    : <span class="block break-words font-sans text-[17px] font-light leading-[25.5px] text-[#2E2E2E]">{d.value}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: form on a pink panel -->
        <div class="bg-tint4 p-[35px] lg:flex-1">
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/contact/?sent=1"
            class="flex flex-col gap-5"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Leave this empty: <input name="bot-field" /></label></p>

            <div class="grid gap-5 sm:grid-cols-2">
              <Field name="name" label="Name" required placeholder="John Doe" />
              <Field name="organization" label="Organization" placeholder="Organization Name" />
            </div>
            <Field name="phone" label="Phone" type="tel" required placeholder="Phone Number" />
            <Field name="email" label="Email" type="email" required placeholder="abc@gmail.com" />
            <Field name="message" label="Message" textarea rows={4} placeholder="How can we help you?" />

            <button type="submit" class="btn self-start bg-maroon px-5 text-cream hover:bg-[#5c1917]">
              Submit Now
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
