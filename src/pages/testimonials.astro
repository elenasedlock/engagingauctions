---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';

const testimonials = await Promise.all(
  (await getCollection('testimonials'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);
---

<Base
  title="Testimonials"
  description="What event hosts and nonprofit organizations say about working with Elena Sedlock and Engaging Auctions."
>
  <PageBanner title="Testimonials" image="/images/banner/services.webp" />

  <!--
    Live layout: heading row, then cards at 49% / 49% / 100% width, each with
    2em padding, quote text and an image-box (140px logo + name + role).
  -->
  <section class="wrap">
    <div class="flex flex-wrap gap-5 p-2.5 py-[70px] md:py-[60px] lg:py-[70px]">
      <div class="w-full">
        <SectionHeading eyebrow="Client Experiences" title="Testimonials Event Hosts & Organizations" class="!gap-[15px]" />
      </div>

      {testimonials.map(({ data, Content }, i) => (
        <figure
          class:list={[
            'flex flex-col justify-between gap-6 bg-tint4 p-[32px]',
            i < 2 ? 'w-full lg:min-h-[423px] lg:w-[calc(50%-10px)]' : 'w-full lg:min-h-[324px]',
          ]}
        >
          <blockquote class="font-sans text-[17px] font-light leading-[25.5px] text-[#2E2E2E]"><Content /></blockquote>
          <figcaption class="flex items-center gap-5">
            {data.logo && (
              <img
                src={data.logo}
                alt={data.org}
                class="shrink-0 object-fill"
                style={`width:${data.logoWidth}px;height:${data.logoHeight}px`}
                width={data.logoWidth} height={data.logoHeight}
              />
            )}
            <div class="flex-1">
              <p class="font-display text-[25px] font-medium capitalize leading-[30px] text-ink">{data.name}</p>
              <p class="font-sans text-[17px] font-light leading-[25.5px] text-maroon">
                {data.role ? `${data.role}, ${data.org}` : data.org}
              </p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CTASection pad={100} />
</Base>
