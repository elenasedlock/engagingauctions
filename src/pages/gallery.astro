---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Btn from '../components/Btn.astro';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order).filter((v) => v.data.short);

// Live shows three photos and reveals the rest behind "Load More".
const VISIBLE = 3;
---

<Base
  title="Gallery"
  description="Photos and video highlights from benefit auctions and fundraising galas hosted by Engaging Auctions."
>
  <PageBanner title="Gallery" image="/images/banner/services.webp" />

  <!-- Videos — two portrait Shorts at 390x694 -->
  <section class="bg-tint4">
    <div class="wrap">
      <div class="flex flex-col gap-5 py-[70px] md:py-[60px] lg:py-[70px]">
        <div class="flex flex-col items-start justify-between gap-5 lg:flex-row">
          <SectionHeading eyebrow="Highlights" title="Videos Moments From Our Auctions" class="!gap-[15px] lg:w-[854px]" />
          <div class="p-2.5 lg:text-right"><Btn href="/consultation/">Event Consultation</Btn></div>
        </div>
        <div class="flex flex-col gap-5 p-2.5 lg:flex-row">
          {videos.map((v) => (
            <div class="relative h-[694px] w-full overflow-hidden bg-ink lg:w-[390px]">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.data.youtubeId}?rel=0`}
                title={v.data.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="absolute left-1/2 top-1/2 h-[118%] w-[118%] -translate-x-1/2 -translate-y-1/2"
              ></iframe>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Photos — 407x400 each with 10px padding, three across, Load More reveals the rest -->
  <section class="wrap">
    <div class="flex flex-col gap-5 py-[70px] md:py-[60px] lg:py-[70px]">
      <div class="flex flex-col items-start justify-between gap-5 lg:flex-row">
        <SectionHeading eyebrow="Highlights" title="Photos Moments From Our Auctions" class="!gap-[15px] lg:w-[854px]" />
        <div class="p-2.5 lg:text-right"><Btn href="/consultation/">Event Consultation</Btn></div>
      </div>

      <div class="gallery" data-visible={VISIBLE}>
        <div class="grid grid-cols-1 p-2.5 sm:grid-cols-2 lg:grid-cols-3">
          {photos.map((p, i) => (
            <img
              src={p.data.image}
              alt={p.data.alt}
              class:list={['gallery__item h-[400px] w-full object-cover p-2.5', i >= VISIBLE && 'hidden']}
              width="407" height="400" loading="lazy"
            />
          ))}
        </div>
        {photos.length > VISIBLE && (
          <div class="mt-8 p-2.5">
            <button type="button" class="gallery__more btn bg-maroon text-white hover:bg-[#5c1917]" style="padding:20px 40px">
              Load More
            </button>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.gallery__more');
    btn?.addEventListener('click', () => {
      root.querySelectorAll('.gallery__item.hidden').forEach((el) => el.classList.remove('hidden'));
      btn.closest('div')?.remove();
    });
  });
</script>
