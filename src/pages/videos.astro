---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';

const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const feature = videos.find((v) => v.data.short) ?? videos[0];
---

<Base
  title="Videos"
  description="Watch Engaging Auctions in action — live benefit auctions, paddle raises, and event highlights."
>
  <PageBanner title="Videos" image="/images/banner/services.webp" />

  <!-- Live: padding 100/20, headings left, video with a poster overlay right -->
  <section class="wrap">
    <div class="flex flex-col gap-5 py-[100px] md:py-[60px] lg:py-[100px] lg:flex-row">
      <div class="flex flex-col gap-5 p-2.5 lg:w-1/2">
        <SectionHeading eyebrow="Auctions In Action" title="See The Energy. Feel The Excitement." />
      </div>
      <div class="p-2.5 lg:w-1/2">
        <div class="aspect-[9/16] w-full overflow-hidden bg-ink">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${feature.data.youtubeId}?rel=0`}
            title={feature.data.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="h-full w-full"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <CTASection pad={100} />
</Base>
