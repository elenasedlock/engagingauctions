---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
---

<Base
  title="Videos"
  description="Watch Engaging Auctions in action — live benefit auctions, paddle raises, and event highlights."
>
  <PageBanner title="Videos" image="/images/banner/services.webp" crumbLight />

  <!-- Live: padding 100/20; heading block 570 left, self-hosted 570x1013 video right -->
  <section class="wrap">
    <div class="flex flex-col gap-5 py-[100px] md:py-[60px] lg:flex-row lg:py-[100px]">
      <div class="flex flex-col gap-5 p-2.5 lg:w-[610px]">
        <SectionHeading eyebrow="Auctions In Action" title="See The Energy. Feel The Excitement." />
      </div>
      <div class="p-2.5">
        <video
          class="aspect-[9/16] w-full object-cover lg:aspect-auto lg:h-[1013px] lg:w-[570px]"
          src="/video/elena-auctioneer.mp4"
          controls
          playsinline
          preload="metadata"
        ></video>
      </div>
    </div>
  </section>

  <CTASection pad={100} />
</Base>
