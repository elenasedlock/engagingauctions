---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const steps = await Promise.all(
  (await getCollection('process'))
    .sort((a, b) => a.data.step - b.data.step)
    .map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);
---

<Base
  title="Services"
  description="Benefit auctioneering, fundraising consultation, and event hosting for nonprofit galas, school auctions, and charitable fundraisers."
>
  <PageBanner title="Services" image="/images/banner/services.webp" />

  <!-- Our Auction Process — padding 70/20, gap 30, three maroon cards (25px padding) -->
  <section class="bg-tint4">
    <div class="wrap">
      <div class="flex flex-col gap-[30px] py-[70px] md:py-[60px] lg:py-[70px]">
        <SectionHeading eyebrow="Our Auction Process" title="A Clear, Organized Approach To Successful Auctions" />
        <ol class="grid gap-5 md:grid-cols-3">
          {steps.map(({ data, Content }) => (
            <li class="flex flex-col gap-5 bg-maroon p-[25px] text-white">
              <Icon name={({chat:"chat",check:"check-square",play:"play"}[data.icon] ?? "chat") as any} size={35} view="stacked" box={70} />
              <h3 class="text-[28px] leading-[33.6px] text-white">Step {data.step}: {data.title}</h3>
              <div class="text-[16px] font-light leading-[24px] text-white"><Content /></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- One row per service, padding 70/20, alternating row / row-reverse -->
  {services.map((s, i) => (
    <section>
      <div class="wrap">
        <div
          class:list={[
            'flex flex-col items-center gap-5 py-[70px] md:py-[60px] lg:py-[70px]',
            i % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row',
          ]}
        >
          <div class="flex flex-col gap-5 p-2.5 lg:flex-1">
            <Icon name={(["user","heart-multiple","play"][i] ?? "user") as any} size={25} view="stacked" box={51} />
            <h2>{s.data.title}</h2>
            <p class="font-sans text-[18px] font-light leading-[27px] text-[#2E2E2E]">{s.data.blurb}</p>
            <div><Btn href="/consultation/">Get Consultation</Btn></div>
          </div>
          {s.data.image && (
            <div class="p-2.5 lg:flex-1">
              <img src={s.data.image} alt={s.data.title} class="w-full object-cover" style={`aspect-ratio:590/${s.data.imageHeight}`} width="590" height={s.data.imageHeight} />
            </div>
          )}
        </div>
      </div>
    </section>
  ))}
</Base>
