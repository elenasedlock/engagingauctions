---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Field from '../components/Field.astro';
---

<Base
  title="Request a Booking"
  description="Request Elena Sedlock and Engaging Auctions for your upcoming gala, school auction, or fundraising event."
>
  <PageBanner title="Request a Booking" image="/images/banner/services.webp" />

  <section class="wrap">
    <div class="flex flex-col gap-5 px-2.5 py-[80px] md:py-[60px] lg:py-[80px]">
      <h2 class="text-center lg:text-center">Request A Booking</h2>

      <form
        name="booking"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/request-a-booking/?sent=1"
        class="mx-auto mt-4 flex w-full max-w-3xl flex-col gap-5"
      >
        <input type="hidden" name="form-name" value="booking" />
        <p class="hidden"><label>Leave this empty: <input name="bot-field" /></label></p>

        <Field name="name" label="Full Name" required />
        <Field name="phone" label="Phone" type="tel" required placeholder="(201) 555-0123" />
        <Field name="email" label="Email" type="email" required />

        <button type="submit" class="btn self-start bg-maroon px-5 text-cream hover:bg-[#5c1917]">
          Book Now
        </button>
      </form>
    </div>
  </section>
</Base>
