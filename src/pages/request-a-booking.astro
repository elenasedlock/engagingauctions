---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Field from '../components/Field.astro';
---

<Base
  title="Request a Booking"
  description="Request Elena Sedlock and Engaging Auctions for your upcoming gala, school auction, or fundraising event."
>
  <PageBanner title="Request a Booking" />

  <!--
    Live: section padding 80/20, full-width form (no panel background),
    Full Name + Phone side by side at 600 each, Email full width at 1220,
    submit full width 1220x59.
  -->
  <section class="wrap">
    <div class="flex flex-col gap-5 py-[80px] md:py-[60px] lg:py-[80px]">
      <h2 class="p-2.5 text-center">Request A Booking</h2>

      <form
        name="booking"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/request-a-booking/?sent=1"
        class="flex flex-col gap-5 p-2.5"
      >
        <input type="hidden" name="form-name" value="booking" />
        <p class="hidden"><label>Leave this empty: <input name="bot-field" /></label></p>

        <div class="grid gap-5 sm:grid-cols-2">
          <Field name="name" label="Full Name" required labelLeading={19} />
          <Field name="phone" label="Phone" type="tel" required placeholder="(201) 555-0123" labelLeading={19} />
        </div>
        <Field name="email" label="Email" type="email" required labelLeading={19} />

        <button
          type="submit"
          class="btn h-[59px] w-full bg-maroon px-[15px] py-0 text-cream hover:bg-[#5c1917]"
        >
          Book Now
        </button>
      </form>
    </div>
  </section>
</Base>
