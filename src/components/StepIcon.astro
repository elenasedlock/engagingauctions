---
interface Props { name: 'chat' | 'check' | 'play' }
const { name } = Astro.props;
const paths = {
  chat: 'M4 4h16v11H8l-4 4V4Z',
  check: 'M5 4h14v16H5V4Zm3 8 2.5 2.5L16 9',
  play: 'M7 4.5 18.5 12 7 19.5v-15Z',
};
const filled = name !== 'check';
---
<!-- 70x70 cream tile, maroon glyph, matching the live process cards. -->
<span class="flex h-[70px] w-[70px] items-center justify-center bg-cream text-maroon">
  <svg width="35" height="35" viewBox="0 0 24 24"
       fill={filled ? 'currentColor' : 'none'}
       stroke="currentColor" stroke-width={filled ? 0 : 1.8}
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={paths[name]} />
  </svg>
</span>
