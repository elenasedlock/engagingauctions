---
import { site } from '../data/site';
---
<section class="bg-cream">
  <div class="mx-auto max-w-4xl px-5 py-16 text-center">
    <h2 class="text-3xl sm:text-4xl">Ready to Elevate Your Event?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-ink/70">
      Let's create an auction experience your guests will remember — and your
      organization will benefit from.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/request-a-booking/" class="rounded-full bg-maroon px-6 py-3 text-sm font-medium text-cream hover:bg-brick">
        Book Your Auction
      </a>
      <a href="/contact/" class="rounded-full border border-maroon px-6 py-3 text-sm font-medium text-maroon hover:bg-maroon hover:text-cream">
        Contact Our Team
      </a>
    </div>
    <p class="mt-6 text-sm text-ink/55">
      Or call <a href={site.phoneHref} class="text-brick hover:underline">{site.phone}</a>
    </p>
  </div>
</section>
