---
interface Props { id: string; title: string; short?: boolean; fill?: boolean }
const { id, title, short = false, fill = false } = Astro.props;
---
<div class:list={['w-full overflow-hidden bg-ink', fill ? 'h-full' : short ? 'aspect-[9/16]' : 'aspect-video']}>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
    title={title}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    class="h-full w-full"
  ></iframe>
</div>
