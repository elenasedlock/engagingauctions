---
import HeroSlideshow from './HeroSlideshow.astro';

interface Props {
  title: string;
  crumb?: string;
  /** /videos/ renders the breadcrumb as plain white text, not on a cream chip. */
  crumbLight?: boolean;
  /** Static background image. Omit to use the 5-image slideshow (used on /about/). */
  image?: string;
}
const { title, crumb, image, crumbLight = false } = Astro.props;

// Every inner-page banner is min-height 420px (250px on mobile) with 85px/20px
// padding, and sits under the 117px header exactly as the homepage hero does.
const slideshow = [
  '/images/banner/banner-1.jpg',
  '/images/banner/banner-2.jpg',
  '/images/banner/banner-3.jpg',
  '/images/banner/banner-4.jpg',
  '/images/banner/banner-5.jpg',
];
---
<section class="relative overflow-hidden bg-ink">
  {image ? (
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image:url(${image})`} aria-hidden="true"></div>
  ) : (
    <HeroSlideshow images={slideshow} duration={5000} />
  )}
  <div class="absolute inset-0 bg-black/35" aria-hidden="true"></div>

  <!--
    Live: inner container is padding 85/0/20 with align-items:center inside a
    420px min-height, so the title lands at y=199. Heading is the global h1
    (80px/88px), breadcrumb chip is right-aligned and vertically centred.
  -->
  <div class="wrap relative flex min-h-[250px] items-center pb-5 pt-[85px] md:min-h-[420px]">
    <div class="flex w-full flex-col items-start gap-5 sm:flex-row sm:items-center">
      <div class="p-2.5 sm:w-1/2">
        <h1 class="text-white">{title}</h1>
      </div>

      <nav aria-label="Breadcrumb" class="p-2.5 sm:flex sm:w-1/2 sm:justify-end">
        <ol class:list={["flex items-center gap-[5px] px-5 py-2 font-sans text-[15px] uppercase tracking-[1px]", crumbLight ? "text-white" : "bg-cream text-maroon"]}>
          <li class="flex items-center gap-[5px]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1.5 1 7.2h2v7.3h4V10h2v4.5h4V7.2h2L8 1.5Z" />
            </svg>
            <a href="/" class="hover:underline">Home</a>
          </li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2.5 8h11M9.5 4.5 13 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </li>
          <li aria-current="page">{crumb ?? title}</li>
        </ol>
      </nav>
    </div>
  </div>
</section>
