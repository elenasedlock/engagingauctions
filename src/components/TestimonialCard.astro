---
interface Props { name: string; org: string; role?: string }
const { name, org, role } = Astro.props;
---
<figure class="flex h-full flex-col rounded-2xl border border-line bg-white p-7 shadow-sm">
  <svg class="mb-4 h-7 w-7 text-brick/30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M9.6 4.8c-3.6 1.9-5.9 5-5.9 9v5.4h6.6v-6.6H7.1c0-2.4 1.2-4.1 3.4-5.2l-.9-2.6Zm10.2 0c-3.6 1.9-5.9 5-5.9 9v5.4h6.6v-6.6h-3.2c0-2.4 1.2-4.1 3.4-5.2l-.9-2.6Z"/>
  </svg>
  <blockquote class="flex-1 font-serif text-lg leading-relaxed text-ink/85">
    <slot />
  </blockquote>
  <figcaption class="mt-6 border-t border-line pt-4">
    <p class="font-medium text-ink">{name}</p>
    <p class="text-sm text-ink/60">{role ? `${role}, ${org}` : org}</p>
  </figcaption>
</figure>
