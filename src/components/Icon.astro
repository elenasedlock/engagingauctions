---
import { Icon as Iconify } from 'astro-icon/components';

/**
 * The real icons the WordPress site uses, via Iconify:
 *   why-choose : fas fa-microphone-alt | mdi mdi-flash | ion ion-md-settings | fas fa-users
 *   process    : icon_chat | fas fa-check-square | icomoon-play3
 *   services   : fas fa-user | mdi mdi-heart-multiple | icomoon-play3
 *   impact     : fas fa-file-invoice-dollar
 *   contact    : fa phone | envelope | map-marker
 */
export const ICONS = {
  microphone: 'fa6-solid:microphone-lines',
  flash: 'mdi:flash',
  settings: 'ion:md-settings',
  users: 'fa6-solid:users',
  chat: 'fa6-solid:comments',
  'check-square': 'fa6-solid:square-check',
  play: 'fa6-solid:play',
  user: 'fa6-solid:user',
  'heart-multiple': 'mdi:heart-multiple',
  'file-invoice-dollar': 'fa6-solid:file-invoice-dollar',
  phone: 'fa6-solid:phone',
  envelope: 'fa6-solid:envelope',
  location: 'fa6-solid:location-dot',
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  /** framed = 3px maroon border; cream = cream tile, maroon glyph; stacked = maroon tile, white glyph */
  view?: 'framed' | 'cream' | 'stacked';
  box?: number;
  class?: string;
}
const { name, size = 35, view = 'cream', box = 70, class: cls = '' } = Astro.props;

const chrome =
  view === 'framed' ? 'border-[3px] border-maroon text-maroon'
  : view === 'stacked' ? 'bg-maroon text-white'
  : 'bg-cream text-maroon';
---
<span
  class:list={['inline-flex shrink-0 items-center justify-center', chrome, cls]}
  style={`width:${box}px;height:${box}px`}
>
  <Iconify name={ICONS[name]} width={size} height={size} />
</span>
