---
/**
 * Icons matched to the Elementor source, one per card:
 *   why-choose: fas fa-microphone-alt | mdi mdi-flash | ion ion-md-settings | fas fa-users
 *   process:    icon_chat | fas fa-check-square | icomoon-play3
 *   services:   fas fa-user | mdi mdi-heart-multiple | icomoon-play3
 *   impact:     fas fa-file-invoice-dollar
 */
interface Props {
  name: 'microphone' | 'flash' | 'settings' | 'users' | 'chat' | 'check-square' | 'play' | 'user' | 'heart-multiple' | 'file-invoice-dollar';
  size?: number;
  /** framed = 3px border, transparent bg. stacked = solid maroon bg, light glyph. */
  view?: 'framed' | 'stacked';
  box?: number;
  class?: string;
}
const { name, size = 35, view = 'framed', box = 70, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  microphone: 'M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21H9v2h6v-2h-2v-3.1A7 7 0 0 0 19 11h-2Z',
  flash: 'M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z',
  settings: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm9.4 4a7.6 7.6 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7.5 7.5 0 0 0-2-1.2L16.5 3h-4l-.4 2.6c-.7.3-1.4.7-2 1.2l-2.4-1-2 3.4 2 1.6a7.6 7.6 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-1c.6.5 1.3.9 2 1.2l.4 2.6h4l.4-2.6c.7-.3 1.4-.7 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z',
  users: 'M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 2c-2.7 0-8 1.3-8 4v3h10v-3c0-1 .4-2.2 1.3-3.1A14 14 0 0 0 8 13Zm8 0c-.6 0-1.3.1-2 .2 1.3.9 2 2.1 2 3.3V20h8v-3c0-2.7-5.3-4-8-4Z',
  chat: 'M4 4h16v11H8l-4 4V4Z',
  'check-square': 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm5.5 13.5 7-7-1.4-1.4-5.6 5.6-2.6-2.6L6.5 12.5l4 4Z',
  play: 'M7 4.5 18.5 12 7 19.5v-15Z',
  user: 'M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5Z',
  'heart-multiple': 'M11 20.4 9.6 19.1C4.4 14.4 1 11.3 1 7.5 1 4.4 3.4 2 6.5 2c1.7 0 3.4.8 4.5 2.1C12.1 2.8 13.8 2 15.5 2 18.6 2 21 4.4 21 7.5c0 3.8-3.4 6.9-8.6 11.6L11 20.4Z',
  'file-invoice-dollar': 'M6 2h8l4 4v16H6V2Zm7 1.5V7h3.5L13 3.5ZM8 9h5v1.5H8V9Zm0 3h8v1.5H8V12Zm4 3.2c1 0 1.8.5 1.8 1.3h-1.2c0-.2-.3-.3-.6-.3s-.6.1-.6.35c0 .8 2.4.3 2.4 2 0 .8-.6 1.3-1.4 1.45V21h-1.2v-.95c-.9-.15-1.6-.7-1.6-1.5h1.2c0 .3.4.5.9.5.4 0 .7-.15.7-.4 0-.8-2.4-.3-2.4-2 0-.75.6-1.25 1.5-1.4V14.3H12v.9Z',
};
const chrome = view === 'framed'
  ? 'border-[3px] border-maroon text-maroon'
  : 'bg-maroon text-white';
---
<span
  class:list={['inline-flex shrink-0 items-center justify-center', chrome, cls]}
  style={`width:${box}px;height:${box}px`}
>
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={paths[name]} />
  </svg>
</span>
